{
  "manifest_version": 3,
  "name": "Virio : protection contre les arnaques",
  "short_name": "Virio",
  "version": "0.1.0",
  "description": "Faux SMS d'amende, de colis ou de banque : Virio repère le faux site au moment du clic, le bloque et vous montre le vrai.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Virio",
    "default_popup": "src/pages/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "permissions": ["storage", "webNavigation", "alarms"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "virio@virio.fr",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
